# Ambiente: 'dev' = SQLite local (banco db.sqlite3); 'prd' = PostgreSQL (usado
# pelo docker compose). Troque para DJANGO_ENV=prd ao subir com compose.
DJANGO_ENV=dev

SECRET_KEY='SUA CHAVE DJANGO'
DEBUG=True
ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost

# PostgreSQL — usados somente quando DJANGO_ENV=prd (docker compose).
# No modo dev (SQLite) estas variáveis são ignoradas.
POSTGRES_DB=sge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=sge_db
POSTGRES_PORT=5432
